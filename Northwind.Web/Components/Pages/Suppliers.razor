@page "/suppliers"
@inject NorthwindContext _db
<div class="row">
	<h1 class="display-2">Suppliers</h1>
	<table class="table">
		<thead class="thead-inverse">
			<tr>
				<th>Company Name</th>
				<th>Country</th>
				<th>Phone</th>
			</tr>
		</thead>
		<tbody>
			@if (Companies is not null)
			{
				@foreach (dynamic s in Companies)
				{
					<tr>
						<td>@s.CompanyName</td>
						<td>@s.Country</td>
						<td>@s.Phone</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>