<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
	xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="configuration">
		<xs:complexType>
			<xs:all>
				<!-- General configuration settings -->
				<xs:element name="config" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="clear" minOccurs="0" maxOccurs="1" />
							<xs:element name="add" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:attribute name="key" type="xs:string" use="required" />
									<xs:attribute name="value" type="xs:string" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<!-- Package Sources -->
				<xs:element name="packageSources" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="clear" minOccurs="0" maxOccurs="1" />
							<xs:element name="add" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:attribute name="key" type="xs:string" use="required" />
									<xs:attribute name="value" type="xs:string" use="required" />
									<xs:attribute name="protocolVersion" type="xs:string"
										use="optional" />
									<xs:attribute name="allowInsecureConnections" type="xs:boolean"
										use="optional" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<!-- Package Source Credentials -->
				<xs:element name="packageSourcesCredentials" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<!-- Package Source Mapping -->
				<xs:element name="packageSourceMapping" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="clear" minOccurs="0" maxOccurs="1" />
							<xs:element name="packageSource" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="package" minOccurs="0"
											maxOccurs="unbounded">
											<xs:complexType>
												<xs:attribute name="pattern" type="xs:string"
													use="required" />
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="key" type="xs:string" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<!-- Auditing -->
				<xs:element name="auditSources" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="clear" minOccurs="0" maxOccurs="1" />
							<xs:element name="add" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:attribute name="key" type="xs:string" use="required" />
									<xs:attribute name="value" type="xs:string" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<!-- Diagnostic / Management Nodes -->
				<xs:element name="apikeys" minOccurs="0" maxOccurs="1" type="xs:anyType" />
				<xs:element name="activePackageSource" minOccurs="0" maxOccurs="1" type="xs:anyType" />
				<xs:element name="disabledPackageSources" minOccurs="0" maxOccurs="1"
					type="xs:anyType" />
				<xs:element name="trustedSigners" minOccurs="0" maxOccurs="1" type="xs:anyType" />
				<xs:element name="bindingRedirects" minOccurs="0" maxOccurs="1" type="xs:anyType" />
				<xs:element name="packageManagement" minOccurs="0" maxOccurs="1" type="xs:anyType" />
			</xs:all>
		</xs:complexType>
	</xs:element>
</xs:schema>